{
  "manifest_version": 3,
  "name": "Trade Journal for TradingView",
  "short_name": "Trade Journal",
  "version": "1.4.34",
  "description": "Log backtest, live and invest trades from TradingView straight into your Trade Journal: analysis, result and W/D/4H snapshots.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Trade Journal: show or hide the panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://hmkikstwphyiwxtjlejt.supabase.co/*",
    "https://dashicledev.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart/*"
      ],
      "js": [
        "hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.tradingview.com/chart/*"
      ],
      "js": [
        "plan-default.js",
        "panel/styles.js",
        "panel/core.js",
        "panel/shell.js",
        "panel/position.js",
        "panel/steps.js",
        "panel/grade.js",
        "panel/render.js",
        "panel/events.js",
        "panel/boot.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dashicledev.github.io/TradeJournal/*"
      ],
      "js": [
        "replay-link.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "fonts/*"
      ],
      "matches": [
        "https://*.tradingview.com/*"
      ]
    }
  ]
}
